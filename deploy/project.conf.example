PROJECT_NAME=agenda
APP_USER=www-data
APP_GROUP=www-data
APP_DOMAIN=agenda.tu-dominio.com
APP_REPOSITORY=https://github.com/evallardy/agenda.git
APP_BRANCH=main
APP_BASE_DIR=/srv/www
APP_SOURCE_DIR=${APP_BASE_DIR}/${PROJECT_NAME}/app
APP_VENV_DIR=${APP_BASE_DIR}/${PROJECT_NAME}/.venv
APP_RUN_DIR=/run/gunicorn
APP_LOG_DIR=/var/log/gunicorn
DJANGO_SETTINGS_MODULE=agenda.settings
DJANGO_ENV=production
DJANGO_ENV_FILE=.env.production
DJANGO_WSGI_MODULE=agenda.wsgi
DJANGO_MANAGE_PATH=${APP_SOURCE_DIR}/manage.py
GUNICORN_BIND=unix:${APP_RUN_DIR}/${PROJECT_NAME}.sock
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
LETSENCRYPT_EMAIL=admin@tu-dominio.com